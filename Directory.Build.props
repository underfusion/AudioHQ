<Project>

  <!--
    CANONICAL VERSION - single source of truth for the whole solution.
    Rules (see CLAUDE.md "Versioning"):
      - bump the PATCH digit on EVERY edit batch (0.1.0 -> 0.1.1 -> ... -> 0.1.9)
      - after patch 9, roll to the next minor automatically (0.1.9 -> 0.2.0)
      - MAJOR bumps only on explicit user approval
      - update CHANGELOG.md and review docs/ARCHITECTURE.md with every bump
    All projects under src/ inherit this file automatically (MSBuild convention).
  -->
  <PropertyGroup>
    <Version>0.5.20</Version>
    <Product>AudioHQ</Product>
    <Authors>underfusion</Authors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

</Project>
