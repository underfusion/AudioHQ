<!--
    Spacing and corner radii.

    Spacing is a 6px rhythm: S=6 (half), M=12 (normal), L=24 (double). Radii are named by
    the element they belong to, so a pill and a card cannot drift apart.

    Not every margin in the app is a token: genuinely one-off geometry (computed layout,
    optical nudges) stays a literal rather than being forced onto this scale.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing scale -->
    <sys:Double x:Key="SpacingS">6</sys:Double>
    <sys:Double x:Key="SpacingM">12</sys:Double>
    <sys:Double x:Key="SpacingL">24</sys:Double>

    <!-- Corner radii -->
    <!-- Small controls: pills, scroll thumbs, tight chips. -->
    <CornerRadius x:Key="Radius.Sm">3</CornerRadius>
    <!-- Buttons and inputs. -->
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <!-- Larger interactive surfaces. -->
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
    <!-- Strip/panel cards. -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>

</ResourceDictionary>
