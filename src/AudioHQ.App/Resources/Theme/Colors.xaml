<!--
    Raw palette - the only place a hex literal belongs.

    Nothing outside this file should name a colour by its value; screens and code use the
    semantic aliases in Semantic.xaml instead. Keys here describe the COLOUR, not its job.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (darkest to lightest) -->
    <Color x:Key="Color.Background">#FF161A22</Color>
    <Color x:Key="Color.Card">#FF222834</Color>
    <Color x:Key="Color.Control">#FF2D3545</Color>
    <Color x:Key="Color.ComboPopup">#FF2A3040</Color>
    <Color x:Key="Color.MasterCard">#FF2A3550</Color>
    <Color x:Key="Color.MasterBorder">#FF4A557A</Color>
    <Color x:Key="Color.ScrollTrack">#FF3C4E68</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFE2E7F0</Color>
    <Color x:Key="Color.TextMuted">#FF8B93A5</Color>
    <Color x:Key="Color.White">#FFFFFFFF</Color>

    <!-- Accents -->
    <Color x:Key="Color.Green">#FF22C55E</Color>
    <Color x:Key="Color.Red">#FFEF4444</Color>
    <Color x:Key="Color.Blue">#FF3B82F6</Color>

    <!-- Fader ramp. These are deliberately lighter than the accents above: they sit on a
         moving fader against the card fill and need more contrast there. Reconciling them
         with the accents is a separate, user-visible decision (see the Phase 3 code-behind
         colour item) - keep the current values until then. -->
    <Color x:Key="Color.FaderGreen">#FF4ADE80</Color>
    <Color x:Key="Color.FaderAmber">#FFFBBF24</Color>
    <Color x:Key="Color.FaderRed">#FFF87171</Color>

    <!-- Notification bubble fills: a faint tint of the accent so the frame reads as a toast
         rather than as loose coloured text. -->
    <Color x:Key="Color.InfoBubble">#FF1C2A40</Color>
    <Color x:Key="Color.ErrorBubble">#FF35222A</Color>

</ResourceDictionary>
