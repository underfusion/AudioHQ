<!--
    Text sizes by role. Views should name the role, not the number, so the same semantic
    element cannot drift to 9 in one window and 10 in another.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Smallest legible label: tick marks, unit suffixes. -->
    <sys:Double x:Key="FontSize.Caption">9</sys:Double>
    <!-- Secondary/dim labels and dense list rows. -->
    <sys:Double x:Key="FontSize.Small">10</sys:Double>
    <!-- Default body text. -->
    <sys:Double x:Key="FontSize.Body">11</sys:Double>
    <!-- Emphasised body: channel names, values worth reading first. -->
    <sys:Double x:Key="FontSize.BodyStrong">12</sys:Double>
    <!-- Dialog/section titles. -->
    <sys:Double x:Key="FontSize.Title">15</sys:Double>
    <!-- Window headers. -->
    <sys:Double x:Key="FontSize.Header">16</sys:Double>
    <!-- Icon-font glyphs (Segoe Fluent chevrons, dock arrows). -->
    <sys:Double x:Key="FontSize.Glyph">24</sys:Double>

</ResourceDictionary>
