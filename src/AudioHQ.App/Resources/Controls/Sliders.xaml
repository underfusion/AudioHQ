<!--
    Faders: the vertical channel/master fader and the compact horizontal per-app fader.

    The vertical Fader keeps the default WPF slider template (its thumb and tick geometry are
    supplied where the strip is declared); only the app-mixer fader is fully retemplated.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Fader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Height" Value="170" />
        <Setter Property="Width" Value="30" />
        <!-- No dotted keyboard-focus rectangle around the track. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,0,4" />
        <!-- Threshold ticks; per-slider Ticks set where the strip is declared. -->
        <Setter Property="TickPlacement" Value="Both" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <!-- Single click jumps the thumb to the clicked point (double-click snaps to 100%). -->
        <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>

    <!-- Small numeral printed beside a fader tick (the "numbers" on the scale). -->
    <Style x:Key="ScaleLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Compact horizontal fader for the per-app mixer rows: thin track, green fill up to the
         thumb (the played portion), light round thumb. Click-to-point like the strips. -->
    <Style x:Key="AppSlider" TargetType="Slider">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18" Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource Brush.Control}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{StaticResource Brush.AccentPositive}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14" Fill="{StaticResource Brush.TextPrimary}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
