<!--
    Strip cards and their fixed-geometry zones.

    The channel card, the master card and the add-placeholder all share one geometry
    (StripCard); the variants only change fill and border, so strips stay aligned.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StripCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Width" Value="118" />
    </Style>

    <!-- Master strip: same geometry as a channel card, set apart by a lighter shade and a
         thin accent border so the eye separates it from the outputs. -->
    <Style x:Key="MasterCard" TargetType="Border" BasedOn="{StaticResource StripCard}">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Outlined placeholder card the user clicks to add a new channel. -->
    <Style x:Key="AddCard" TargetType="Border" BasedOn="{StaticResource StripCard}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="58" />
    </Style>

    <!-- Fixed-height zone above the fader; identical on master and channels so every slider
         starts at the same Y. -->
    <Style x:Key="ControlsZone" TargetType="StackPanel">
        <Setter Property="Height" Value="60" />
    </Style>

    <Style x:Key="StripName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Height" Value="28" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
