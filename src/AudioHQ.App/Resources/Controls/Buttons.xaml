<!--
    Buttons: dark form buttons for dialogs, plus the small glyph buttons used on strips
    and app-mixer rows.

    DarkButton is the base. DarkButtonColor swaps the hover behaviour (opacity instead of a
    background change) because the filled Success/Danger variants already carry their colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark form controls for dialogs - match the app shell instead of the default white
         Windows chrome. -->
    <Style x:Key="DarkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent (primary) variant of DarkButton - filled blue, for the main action. -->
    <Style x:Key="DarkButtonAccent" TargetType="Button" BasedOn="{StaticResource DarkButton}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentInfo}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    </Style>

    <!-- Filled-colour base: hover dims rather than repainting, so the fill stays readable. -->
    <Style x:Key="DarkButtonColor" TargetType="Button" BasedOn="{StaticResource DarkButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkButtonSuccess" TargetType="Button" BasedOn="{StaticResource DarkButtonColor}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentPositive}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    </Style>

    <Style x:Key="DarkButtonDanger" TargetType="Button" BasedOn="{StaticResource DarkButtonColor}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentNegative}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    </Style>

    <!-- Small square glyph button (rename pencil is inline; this is the remove x / add +). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Control}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sliders glyph that lives inside the EQ pill (transparent so the pill shows through).
         No tooltip; the icon just recolours on hover to signal it is clickable. -->
    <Style x:Key="PillGearButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Viewbox Width="14" Height="14">
                            <Path x:Name="Glyph" Fill="{StaticResource Brush.TextPrimary}"
                                  Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Brush.AccentInfo}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Per-app pin: a pushpin glyph, dim when unpinned and accent-blue when pinned (the
         pinned state is read from the row's IsPinned via a data trigger). -->
    <Style x:Key="PinButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="ToolTip" Value="Pin to top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Viewbox Width="15" Height="15">
                            <Path x:Name="Glyph" Fill="{StaticResource Brush.TextMuted}"
                                  Data="M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Brush.AccentInfo}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
