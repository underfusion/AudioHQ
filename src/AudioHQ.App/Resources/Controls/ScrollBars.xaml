<!--
    Scrollbars.

    There is ONE template. It used to exist twice - a named AppScrollBar for the app-mixer
    list and a near-identical keyless copy applying app-wide - which drifted apart (only the
    named one had hover/drag feedback). Both variants now derive from ScrollBar.Base, so a
    change to the rail or thumb reaches every scrollbar in the app.

    The keyless variant is global on purpose: it also styles combo-box dropdowns.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slim dark rail (reads against the card fill) with a lighter thumb centred inside it,
         so the rail stays visible on both sides of the thumb. -->
    <Style x:Key="ScrollBar.Base" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <!-- MinWidth 0: the default ScrollBar MinWidth would force the rail wider than 6. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <!-- S (6px) gutter separating the rail from the row content beside it. -->
        <Setter Property="Margin" Value="{StaticResource AppMixerScrollBarMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Border Background="{StaticResource Brush.ScrollTrack}" CornerRadius="{StaticResource Radius.Sm}"
                                Width="6" HorizontalAlignment="Center" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb MinWidth="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Sm}"
                                                    Background="{StaticResource Brush.TextPrimary}"
                                                    Width="6" HorizontalAlignment="Center" Margin="0,1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Named variant used inside AppScrollViewer. -->
    <Style x:Key="AppScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Base}" />

    <!-- Keyless = app-wide default, including combo-box dropdowns. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Base}" />

    <!-- App mixer ScrollViewer: content column plus a slim auto scrollbar. Outer content
         margin owns the 12px left and bottom inset; the scrollbar only owns its own 6px
         gutter and 6px rail on the right. -->
    <Style x:Key="AppScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource AppScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
