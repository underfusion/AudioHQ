<!--
    Toggles: the strip pills (ON / MUTE / EQ), the per-app mute glyph and the tray-focus dot.

    The pills share a shape but not a template: PillToggle takes its checked colour from the
    control's Tag, while MuteToggle and EqPillToggle carry fixed colours and swap their own
    text/glyph, so each keeps its own template.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Generic pill: checked colour comes from the control's Tag. -->
    <ControlTemplate x:Key="PillToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Pill"
                Background="{StaticResource Brush.Control}"
                CornerRadius="7"
                Height="26">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.FontSize="11"
                              TextElement.FontWeight="Bold"
                              TextElement.Foreground="{StaticResource Brush.TextMuted}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource PillToggleTemplate}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Master mute pill: green "ON" while playing, red "MUTED" when the master is muted. -->
    <ControlTemplate x:Key="MuteToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Pill" Background="{StaticResource Brush.AccentPositive}" CornerRadius="7" Height="26">
            <TextBlock x:Name="Txt" Text="ON" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.OnAccent}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.AccentNegative}" />
                <Setter TargetName="Txt" Property="Text" Value="MUTED" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MuteToggle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource MuteToggleTemplate}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- EQ pill: a toggle (click switches the EQ on/off) that lights up blue while it is on. -->
    <ControlTemplate x:Key="EqPillToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Pill" Background="{StaticResource Brush.Control}" CornerRadius="7" Height="26">
            <TextBlock x:Name="Txt" Text="EQ" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.AccentInfo}" />
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="EqPillToggle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource EqPillToggleTemplate}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Per-app mute: a speaker glyph that turns into a red muted-speaker when checked. -->
    <Style x:Key="MuteIconToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="ToolTip" Value="Mute this app" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Viewbox Width="16" Height="16">
                            <Path x:Name="Glyph" Fill="{StaticResource Brush.TextMuted}"
                                  Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Brush.AccentNegative}" />
                            <Setter TargetName="Glyph" Property="Data"
                                    Value="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dot selector for tray-focus: outlined circle, fills green when this channel drives
         the tray icon and responds to middle-click. -->
    <Style x:Key="TrayFocusButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Dot" Width="8" Height="8"
                                 Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5"
                                 Fill="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.AccentPositive}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.AccentPositive}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.AccentPositive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
