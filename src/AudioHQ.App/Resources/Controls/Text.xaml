<!--
    Shared text roles for the dialog windows (Options, EQ).

    Both windows repeated the same title and lowercase section-label patterns inline. Naming
    the role here is what stops the same label drifting to a different size or shade in one
    window only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window's own heading ("Options", "Equalizer - ..."). -->
    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Dim lowercase label introducing a group of controls ("source", "latency", "presets"). -->
    <Style x:Key="DialogSectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodyStrong}" />
    </Style>

    <!-- Body text on a dialog surface (check-box labels, inline values). -->
    <Style x:Key="DialogBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodyStrong}" />
    </Style>

</ResourceDictionary>
