<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AudioHQ.App"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <local:GainToBrushConverter x:Key="GainToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Spacing tokens now live in Theme/Spacing.xaml. -->
        <Thickness x:Key="AppMixerRegionMargin">6,12,0,12</Thickness>
        <Thickness x:Key="AppMixerPanelClosedMargin">0</Thickness>
        <Thickness x:Key="AppMixerPanelOpenMargin">6,0,6,0</Thickness>
        <Thickness x:Key="AppMixerContentMargin">12</Thickness>
        <Thickness x:Key="AppMixerRowPadding">6</Thickness>
        <Thickness x:Key="AppMixerStackGap">0,0,0,6</Thickness>
        <Thickness x:Key="AppMixerScrollBarMargin">6,0,0,0</Thickness>
        <sys:Double x:Key="AppMixerContentWidth">220</sys:Double>
        <sys:Double x:Key="AppMixerPanelWidth">244</sys:Double>
        <Thickness x:Key="MainContentMargin">6,12,12,12</Thickness>

        <!-- LEGACY ALIASES. The palette itself lives in Theme/Colors.xaml and the roles in
             Theme/Semantic.xaml; these keys only forward to it so existing views keep
             working while they migrate. Do not add new ones, and delete each alias once its
             last consumer points at the Brush.* role instead. -->
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Color.Background}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Color.Card}" />
        <SolidColorBrush x:Key="MasterCardBrush" Color="{StaticResource Color.MasterCard}" />
        <SolidColorBrush x:Key="MasterBorderBrush" Color="{StaticResource Color.MasterBorder}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Color.TextPrimary}" />
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource Color.TextMuted}" />
        <SolidColorBrush x:Key="ButtonBrush" Color="{StaticResource Color.Control}" />
        <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource Color.Green}" />
        <SolidColorBrush x:Key="AccentRed" Color="{StaticResource Color.Red}" />
        <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource Color.Blue}" />
        <SolidColorBrush x:Key="InfoBubbleBrush" Color="{StaticResource Color.InfoBubble}" />
        <SolidColorBrush x:Key="ErrorBubbleBrush" Color="{StaticResource Color.ErrorBubble}" />
</ResourceDictionary>
