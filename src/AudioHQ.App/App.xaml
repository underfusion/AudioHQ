<Application x:Class="AudioHQ.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioHQ.App"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:GainToBrushConverter x:Key="GainToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Spacing tokens: S=6 half, M=12 normal, L=24 double -->
        <sys:Double x:Key="SpacingS">6</sys:Double>
        <sys:Double x:Key="SpacingM">12</sys:Double>
        <sys:Double x:Key="SpacingL">24</sys:Double>
        <Thickness x:Key="AppMixerRegionMargin">6,12,0,12</Thickness>
        <Thickness x:Key="AppMixerPanelClosedMargin">6,0,0,0</Thickness>
        <Thickness x:Key="AppMixerPanelOpenMargin">6,0,6,0</Thickness>
        <Thickness x:Key="AppMixerContentMargin">12,12,6,12</Thickness>
        <Thickness x:Key="AppMixerRowPadding">6</Thickness>
        <Thickness x:Key="AppMixerStackGap">0,0,0,6</Thickness>
        <Thickness x:Key="AppMixerScrollBarMargin">6,0,0,0</Thickness>
        <sys:Double x:Key="AppMixerContentWidth">226</sys:Double>
        <sys:Double x:Key="AppMixerPanelWidth">244</sys:Double>

        <SolidColorBrush x:Key="BgBrush" Color="#FF161A22" />
        <SolidColorBrush x:Key="CardBrush" Color="#FF222834" />
        <SolidColorBrush x:Key="MasterCardBrush" Color="#FF2A3550" />
        <SolidColorBrush x:Key="MasterBorderBrush" Color="#FF4A557A" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFE2E7F0" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#FF8B93A5" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#FF2D3545" />
        <SolidColorBrush x:Key="AccentGreen" Color="#FF22C55E" />
        <SolidColorBrush x:Key="AccentRed" Color="#FFEF4444" />
        <SolidColorBrush x:Key="AccentBlue" Color="#FF3B82F6" />

        <!-- Notification bubble fills: a faint tint of the accent so the frame reads as a
             toast (info = blue, error = red) rather than as loose coloured text. -->
        <SolidColorBrush x:Key="InfoBubbleBrush" Color="#FF1C2A40" />
        <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#FF35222A" />

        <Style x:Key="StripCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Width" Value="118" />
        </Style>

        <Style x:Key="StripName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Height" Value="28" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <ControlTemplate x:Key="PillToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Pill"
                    Background="{StaticResource ButtonBrush}"
                    CornerRadius="7"
                    Height="26">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.FontSize="11"
                                  TextElement.FontWeight="Bold"
                                  TextElement.Foreground="{StaticResource DimTextBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource PillToggleTemplate}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Master mute pill: green "ON" while playing, red "MUTE" when the master is muted. -->
        <ControlTemplate x:Key="MuteToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Pill" Background="{StaticResource AccentGreen}" CornerRadius="7" Height="26">
                <TextBlock x:Name="Txt" Text="ON" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentRed}" />
                    <Setter TargetName="Txt" Property="Text" Value="MUTED" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MuteToggle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource MuteToggleTemplate}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- EQ pill: a toggle (click switches the EQ on/off) that lights up blue while it is on. -->
        <ControlTemplate x:Key="EqPillToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Pill" Background="{StaticResource ButtonBrush}" CornerRadius="7" Height="26">
                <TextBlock x:Name="Txt" Text="EQ" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource DimTextBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentBlue}" />
                    <Setter TargetName="Txt" Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="EqPillToggle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource EqPillToggleTemplate}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Sliders glyph that lives inside the EQ pill (transparent so the pill shows through).
             No tooltip; the icon just recolours on hover to signal it is clickable. -->
        <Style x:Key="PillGearButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Viewbox Width="14" Height="14">
                                <Path x:Name="Glyph" Fill="{StaticResource TextBrush}"
                                      Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark form controls for dialogs (buttons, combo, text box) - match the app shell
             instead of the default white Windows chrome. -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{StaticResource MasterBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MasterCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (primary) variant of DarkButton - filled blue, for the main action. -->
        <Style x:Key="DarkButtonAccent" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MasterBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <SolidColorBrush x:Key="ComboPopupBrush" Color="#FF2A3040" />

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource ButtonBrush}" CornerRadius="6"
                                                BorderBrush="{StaticResource MasterBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource DimTextBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MasterCardBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource ComboPopupBrush}" CornerRadius="6"
                                        BorderBrush="{StaticResource MasterBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=Toggle}" Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Width" Value="30" />
            <!-- No dotted keyboard-focus rectangle around the track. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <!-- Threshold ticks; per-slider Ticks set where the strip is declared. -->
            <Setter Property="TickPlacement" Value="Both" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <!-- Single click jumps the thumb to the clicked point (double-click snaps to 100%). -->
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>

        <!-- Small numeral printed beside a fader tick (the "numbers" on the scale). -->
        <Style x:Key="ScaleLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Master strip: same geometry as a channel card, set apart by a lighter
             shade and a thin accent border so the eye separates it from the outputs. -->
        <Style x:Key="MasterCard" TargetType="Border" BasedOn="{StaticResource StripCard}">
            <Setter Property="Background" Value="{StaticResource MasterCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MasterBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Fixed-height zone above the fader; identical on master and channels so
             every slider starts at the same Y. -->
        <Style x:Key="ControlsZone" TargetType="StackPanel">
            <Setter Property="Height" Value="60" />
        </Style>

        <!-- Small square glyph button (rename pencil is inline; this is the remove x / add +). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline rename field shown over the channel name while editing. -->
        <Style x:Key="RenameBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Outlined placeholder card the user clicks to add a new channel. -->
        <Style x:Key="AddCard" TargetType="Border" BasedOn="{StaticResource StripCard}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="58" />
        </Style>

        <!-- Compact horizontal fader for the per-app mixer rows: thin track, green fill up to
             the thumb (the played portion), light round thumb. Click-to-point like the strips. -->
        <Style x:Key="AppSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource ButtonBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource AccentGreen}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="{StaticResource TextBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Named scrollbar used inside AppScrollViewer: a darker full-width track with a
             narrower TextBrush thumb centred inside it (dark rail shows on both sides). -->
        <Style x:Key="AppScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="{StaticResource AppMixerScrollBarMargin}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#3C4E68" CornerRadius="3"
                                    Width="6" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinWidth="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bg" CornerRadius="3"
                                                        Background="{StaticResource TextBrush}"
                                                        Width="6" HorizontalAlignment="Center" Margin="0,1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App mixer ScrollViewer: content column plus a slim auto scrollbar.
             Outer content margin owns the 12px left and bottom inset; the scrollbar
             only owns its own 6px gutter and 6px rail on the right. -->
        <Style x:Key="AppScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Style="{StaticResource AppScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark vertical scrollbar: slim track (#3C4E68 so it reads against CardBrush),
             TextBrush thumb. Left margin = S (6 px) separates rail from row content.
             Global (no key) so it also applies to combo-box dropdowns. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#3C4E68" CornerRadius="3"
                                    Width="6" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource TextBrush}"
                                                        CornerRadius="3" Width="6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-app pin: a pushpin glyph, dim when unpinned and accent-blue when pinned (the
             pinned state is read from the row's IsPinned via a data trigger). -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="ToolTip" Value="Pin to top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Viewbox Width="15" Height="15">
                                <Path x:Name="Glyph" Fill="{StaticResource DimTextBrush}"
                                      Data="M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource AccentBlue}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-app mute: a speaker glyph that turns into a red muted-speaker when checked. -->
        <Style x:Key="MuteIconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="ToolTip" Value="Mute this app" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Viewbox Width="16" Height="16">
                                <Path x:Name="Glyph" Fill="{StaticResource DimTextBrush}"
                                      Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource AccentRed}" />
                                <Setter TargetName="Glyph" Property="Data"
                                        Value="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dot selector for tray-focus: outlined circle, fills green when this channel drives
             the tray icon and responds to middle-click. -->
        <Style x:Key="TrayFocusButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Stroke="{StaticResource DimTextBrush}" StrokeThickness="1.5"
                                     Fill="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentGreen}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentGreen}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentGreen}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
