<Window x:Class="AudioHQ.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:AudioHQ.App"
        mc:Ignorable="d"
        Title="AudioHQ"
        Background="{StaticResource BgBrush}"
        SizeToContent="Width"
        Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <DataTemplate x:Key="AppMixerRowTemplate">
            <!-- Row: drop target; pinned rows get a faint blue tint. -->
            <Border Tag="AppRow" CornerRadius="8" Padding="{StaticResource AppMixerRowPadding}"
                    Margin="{StaticResource AppMixerStackGap}"
                    ClipToBounds="True"
                    AllowDrop="True" Drop="AppRow_Drop" DragOver="AppRow_DragOver">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="Background" Value="{StaticResource InfoBubbleBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />   <!-- drag handle -->
                        <ColumnDefinition Width="30" />   <!-- app icon -->
                        <ColumnDefinition Width="*" />    <!-- name -->
                        <ColumnDefinition Width="Auto" /> <!-- pin + vol% + mute -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Left column: drag handle only. -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Background="Transparent"
                            Margin="0,0,6,0"
                            Cursor="SizeAll" ToolTip="Drag to reorder"
                            MouseLeftButtonDown="AppRow_DragStart">
                        <Canvas Width="14" Height="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{StaticResource DimTextBrush}"
                                  Data="M 3 3 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0 M 11 3 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0 M 3 9 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0 M 11 9 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0 M 3 15 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0 M 11 15 m -1.3 0 a 1.3 1.3 0 1 0 2.6 0 a 1.3 1.3 0 1 0 -2.6 0" />
                        </Canvas>
                    </Border>
                    <!-- App icon (26 x 26). -->
                    <Image Grid.Column="1" Grid.RowSpan="2"
                           Source="{Binding Icon}" Width="30" Height="30"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Name -->
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Name}"
                               Margin="6,0,6,0" Foreground="{StaticResource TextBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- Pin + vol% + mute -->
                    <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource PinButton}"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Command="{Binding DataContext.PinCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding VolumePercent}" MinWidth="22"
                                   TextAlignment="Right" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DimTextBrush}" />
                        <ToggleButton Style="{StaticResource MuteIconToggle}"
                                      IsChecked="{Binding Muted}" Margin="6,0,0,0" />
                    </StackPanel>
                    <!-- Slider -->
                    <Slider Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"
                            Style="{StaticResource AppSlider}" Margin="6,6,6,0"
                            Value="{Binding Volume, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChannelStripTemplate">
            <Border Style="{StaticResource StripCard}" AllowDrop="True"
                    Drop="Channel_Drop" DragOver="Channel_DragOver">
                <StackPanel>
                    <!-- Header zone: grip + remove on top, name (or rename box) below. -->
                    <Grid Height="46">
                        <DockPanel VerticalAlignment="Top" Height="16">
                            <TextBlock Text="&#x2630;" DockPanel.Dock="Left"
                                       Foreground="{StaticResource DimTextBrush}"
                                       FontSize="11" Cursor="SizeAll" ToolTip="Drag to reorder"
                                       MouseLeftButtonDown="Grip_MouseLeftButtonDown" />
                            <Button Content="&#x2715;" DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}" Width="16" Height="16"
                                    ToolTip="Remove channel"
                                    Command="{Binding DataContext.RemoveChannelCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <ToggleButton DockPanel.Dock="Right" Width="16" Height="16" Margin="0,0,2,0"
                                          Style="{StaticResource TrayFocusButton}"
                                          IsChecked="{Binding IsFocused, Mode=OneWay}"
                                          ToolTip="Select for tray control - tray icon shows green dot when ON; middle-click tray icon to toggle this channel on/off"
                                          Command="{Binding DataContext.FocusChannelCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" />
                            <TextBlock />
                        </DockPanel>
                        <TextBlock Text="{Binding Name}"
                                   Margin="0,16,0,0" ToolTip="Double-click to rename"
                                   MouseLeftButtonDown="Name_MouseLeftButtonDown">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StripName}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Style="{StaticResource RenameBox}" Margin="0,18,0,0"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"
                                 IsVisibleChanged="RenameBox_IsVisibleChanged" />
                    </Grid>
                    <!-- Controls zone: ON/OFF toggle, then the EQ toggle with a gear
                         at the right edge that opens the EQ editor. -->
                    <StackPanel Style="{StaticResource ControlsZone}">
                        <ToggleButton Tag="{StaticResource AccentGreen}"
                                      IsChecked="{Binding IsActive}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
                                    <Setter Property="Content" Value="ON" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content" Value="OFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <!-- One pill: clicking the body toggles EQ; the gear sits
                             inside at the right edge and opens the editor. -->
                        <Grid Margin="0,6,0,0">
                            <ToggleButton Style="{StaticResource EqPillToggle}"
                                          IsChecked="{Binding EqEnabled, Mode=TwoWay}"
                                          ToolTip="Toggle EQ on/off" />
                            <!-- Sliders glyph (distinct from the options gear); opens the EQ editor. -->
                            <Button Style="{StaticResource PillGearButton}" HorizontalAlignment="Right"
                                    Width="26" Height="26" Margin="0,0,2,0" Click="ChannelEq_Click" />
                        </Grid>
                    </StackPanel>
                    <!-- Fader zone: double-click anywhere here resets gain to 100%. -->
                    <StackPanel PreviewMouseLeftButtonDown="FaderZone_PreviewMouseLeftButtonDown">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Solid 100% (unity) reference line behind the fader. -->
                            <Rectangle Grid.Column="1" Width="30" Height="2" Fill="{StaticResource AccentGreen}"
                                       VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,68,0,0"
                                       IsHitTestVisible="False" />
                            <Slider Grid.Column="1" Style="{StaticResource Fader}" Minimum="0" Maximum="1.5"
                                    Ticks="0.5,1.5" Value="{Binding Gain, Mode=TwoWay}" />
                            <Canvas Grid.Column="2" Width="24" Height="170" Margin="2,10,0,4">
                                <TextBlock Style="{StaticResource ScaleLabel}" Text="150" Canvas.Top="0" />
                                <TextBlock Style="{StaticResource ScaleLabel}" Text="100" Canvas.Top="52" />
                                <TextBlock Style="{StaticResource ScaleLabel}" Text="50" Canvas.Top="105" />
                            </Canvas>
                        </Grid>
                        <TextBlock Text="{Binding GainPercent}" HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{Binding Gain, Converter={StaticResource GainToBrush}}" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentRed}"
                                   FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- LEFT: collapsible per-app volume mixer, slid in/out with the chevron rail.
             Bound to its own AppMixerViewModel (DataContext set in code-behind). -->
        <DockPanel x:Name="AppMixerRegion" DockPanel.Dock="Left"
                  Margin="{StaticResource AppMixerRegionMargin}"
                  LastChildFill="True">
            <!-- Always-visible toggle rail. Chevron points left when collapsed, right when open. -->
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="54"
                    Margin="0,0,0,0" VerticalAlignment="Center" Click="ToggleAppPanel_Click" ToolTip="App volume mixer">
                <Viewbox Width="10" Height="14">
                    <Path Data="M7 0 L0 7 L7 14" Stroke="{StaticResource DimTextBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Button>

            <!-- Sliding panel width comes from AppMixerPanelWidth in code-behind. -->
            <Border x:Name="AppPanel" DockPanel.Dock="Left" Width="0" ClipToBounds="True"
                    Background="{StaticResource CardBrush}" CornerRadius="12"
                    Margin="{StaticResource AppMixerPanelClosedMargin}">
                <Grid Width="{StaticResource AppMixerContentWidth}" Margin="{StaticResource AppMixerContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource AppMixerStackGap}">
                        <TextBlock Text="MIXER" Foreground="{StaticResource TextBrush}" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="AppMixerDockButton" HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}" Width="22" Height="22"
                                ToolTip="Detach mixer" Click="AppMixerDock_Click">
                            <Grid Width="16" Height="14">
                                <!-- Detach action: dim outlined panel with a left-pointing arrow. -->
                                <Canvas x:Name="AppMixerDetachIcon" Width="16" Height="14" Opacity="0.7">
                                    <Path Data="M2 1 H14 A1 1 0 0 1 15 2 V12 A1 1 0 0 1 14 13 H2 A1 1 0 0 1 1 12 V2 A1 1 0 0 1 2 1 Z M5 1 V13"
                                          Stroke="{StaticResource DimTextBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path Data="M11 4 L8 7 L11 10" Stroke="{StaticResource DimTextBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                                <!-- Attach action: bright filled panel with a right-pointing arrow. -->
                                <Canvas x:Name="AppMixerAttachIcon" Width="16" Height="14" Visibility="Collapsed">
                                    <Path Data="M2 1 H14 A1 1 0 0 1 15 2 V12 A1 1 0 0 1 14 13 H2 A1 1 0 0 1 1 12 V2 A1 1 0 0 1 2 1 Z"
                                          Fill="{StaticResource TextBrush}" />
                                    <Path Data="M5 1 V13" Stroke="{StaticResource CardBrush}" StrokeThickness="1.5" />
                                    <Path Data="M8 4 L11 7 L8 10" Stroke="{StaticResource CardBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Grid>
                        </Button>
                    </Grid>
                    <!-- App rows: pin + drag-handle on the left, icon, name, vol%, mute. -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewer}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl x:Name="AppMixerItems" ItemsSource="{Binding Apps}"
                                          ItemTemplate="{StaticResource AppMixerRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel>
                                            <b:Interaction.Behaviors>
                                                <b:FluidMoveBehavior AppliesTo="Children" Tag="DataContext"
                                                                     Duration="0:0:0.3">
                                                    <b:FluidMoveBehavior.EaseX>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </b:FluidMoveBehavior.EaseX>
                                                    <b:FluidMoveBehavior.EaseY>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </b:FluidMoveBehavior.EaseY>
                                                </b:FluidMoveBehavior>
                                            </b:Interaction.Behaviors>
                                        </StackPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="No apps playing" Foreground="{StaticResource DimTextBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>

        <!-- MAIN: source master + output strips (unchanged). -->
        <DockPanel Margin="{StaticResource MainContentMargin}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <!-- Title row: AudioHQ label left, options gear right. -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AudioHQ" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource DimTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="6,3,0,0" />
                </StackPanel>
                <Button x:Name="OptionsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource IconButton}" Width="26" Height="26"
                        ToolTip="Options - source &amp; latency" Click="Options_Click">
                    <Viewbox Width="16" Height="16">
                        <Path Fill="{StaticResource DimTextBrush}"
                              Data="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 6.166a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843zM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5z" />
                    </Viewbox>
                </Button>
            </Grid>
            <!-- Status notification: a self-dismissing toast (X to close). Blue frame for
                 informational notices (source switched/restored), red for failures. -->
            <Border CornerRadius="8" Padding="10,7" Margin="0,6,0,0" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoBubbleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status.IsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ErrorBubbleBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentRed}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Accent dot, coloured to match the frame (info/error). -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0"
                             Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Status.Message}" Foreground="{StaticResource TextBrush}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#x2715;"
                            Width="18" Height="18" Margin="9,0,0,0" VerticalAlignment="Top"
                            ToolTip="Dismiss" Command="{Binding DismissStatusCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MasterStripControl Grid.Column="0" />

            <!-- Output strips: scrolls horizontally beyond 12; window auto-grows up to 12. -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          MaxWidth="1488">
                <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelStripTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add-channel placeholder: always visible at the right edge. -->
            <Border Grid.Column="2" Style="{StaticResource AddCard}">
                <Button Style="{StaticResource IconButton}" Content="&#x2b;" FontSize="24"
                        VerticalAlignment="Center" ToolTip="Add channel"
                        Click="AddChannel_Click" />
            </Border>
        </Grid>
        </DockPanel>
    </DockPanel>
</Window>
