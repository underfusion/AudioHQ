<Window x:Class="AudioHQ.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioHQ - Options"
        Background="{StaticResource BgBrush}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20" MinWidth="300">
        <TextBlock Text="Options" Foreground="{StaticResource TextBrush}"
                   FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />

        <TextBlock Text="source" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="0,0,0,4" />
        <ComboBox Style="{StaticResource DarkCombo}" Height="28" ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FriendlyName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="latency" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="0,14,0,4" />
        <ComboBox Style="{StaticResource DarkCombo}" Height="28" ItemsSource="{Binding LatencyPresets}"
                  SelectedItem="{Binding SelectedLatency}" />

        <TextBlock Text="tray &amp; startup" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="0,18,0,6" />
        <CheckBox Content="Close to system tray" Foreground="{StaticResource TextBrush}"
                  IsChecked="{Binding TrayOptions.CloseToTray}" Margin="0,0,0,6" Cursor="Hand" />
        <CheckBox Content="Minimize to system tray" Foreground="{StaticResource TextBrush}"
                  IsChecked="{Binding TrayOptions.MinimizeToTray}" Margin="0,0,0,6" Cursor="Hand" />
        <CheckBox Content="Run with Windows" Foreground="{StaticResource TextBrush}"
                  IsChecked="{Binding TrayOptions.RunWithWindows}" Cursor="Hand" />

        <Button Content="Close" Style="{StaticResource DarkButtonAccent}" Click="Close_Click"
                Width="80" Height="28" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
