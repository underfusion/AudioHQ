<Window x:Class="AudioHQ.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioHQ - Options"
        Background="{StaticResource Brush.Surface}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- Every gap here is a spacing token: the three section labels used to sit on three
         different margins (0,0,0,4 / 0,14,0,4 / 0,18,0,6) for the same role. -->
    <StackPanel Margin="{StaticResource Inset.L}" MinWidth="300">
        <TextBlock Text="Options" Style="{StaticResource DialogTitle}"
                   Margin="{StaticResource Gap.BottomM}" />

        <TextBlock Text="source" Style="{StaticResource DialogSectionLabel}"
                   Margin="{StaticResource Gap.SectionLabelFirst}" />
        <ComboBox Style="{StaticResource DarkCombo}" Height="28" ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FriendlyName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="latency" Style="{StaticResource DialogSectionLabel}"
                   Margin="{StaticResource Gap.SectionLabel}" />
        <ComboBox Style="{StaticResource DarkCombo}" Height="28" ItemsSource="{Binding LatencyPresets}"
                  SelectedItem="{Binding SelectedLatency}" />

        <TextBlock Text="tray &amp; startup" Style="{StaticResource DialogSectionLabel}"
                   Margin="{StaticResource Gap.SectionLabel}" />
        <CheckBox Content="Close to system tray" Style="{StaticResource DialogCheckBox}"
                  IsChecked="{Binding TrayOptions.CloseToTray}" />
        <CheckBox Content="Minimize to system tray" Style="{StaticResource DialogCheckBox}"
                  IsChecked="{Binding TrayOptions.MinimizeToTray}" />
        <CheckBox Content="Launch minimized to system tray" Style="{StaticResource DialogCheckBox}"
                  IsChecked="{Binding TrayOptions.LaunchMinimized}" />
        <CheckBox Content="Run with Windows" Style="{StaticResource DialogCheckBox}"
                  IsChecked="{Binding TrayOptions.RunWithWindows}" />

        <Button Content="Close" Style="{StaticResource DarkButtonAccent}" Click="Close_Click"
                Width="80" Height="28" HorizontalAlignment="Right"
                Margin="{StaticResource Gap.TopM}" />
    </StackPanel>
</Window>
