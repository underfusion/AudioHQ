<UserControl x:Class="AudioHQ.App.MasterStripControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource MasterCard}">
        <StackPanel>
            <!-- Header zone. -->
            <Grid Height="46">
                <TextBlock Text="MASTER" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.TextPrimary}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                           Height="20" />
                <TextBlock Text="{Binding Master.Name}" VerticalAlignment="Top" Margin="0,20,0,0"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="{StaticResource FontSize.Small}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           ToolTip="Double-click to rename"
                           MouseLeftButtonDown="MasterName_MouseLeftButtonDown">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Master.IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Style="{StaticResource RenameBox}" VerticalAlignment="Top" Margin="0,20,0,0"
                         Visibility="{Binding Master.IsEditing, Converter={StaticResource BoolToVis}}"
                         Text="{Binding Master.Name, UpdateSourceTrigger=LostFocus}"
                         KeyDown="MasterRenameBox_KeyDown" LostFocus="MasterRenameBox_LostFocus"
                         IsVisibleChanged="RenameBox_IsVisibleChanged" />
            </Grid>
            <!-- Controls zone: mute toggle (mutes the whole master) + EQ placeholder.
                 Master EQ is N/A - the source device itself is not mirrored. -->
            <StackPanel Style="{StaticResource ControlsZone}">
                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Master.Muted}"
                              ToolTip="Mute the master (the whole mirrored source)" />
                <ToggleButton Content="EQ" Style="{StaticResource PillToggle}"
                              Tag="{StaticResource Brush.AccentInfo}" IsEnabled="False" />
            </StackPanel>
            <!-- Fader: balance column left = labels column right, so slider is visually centred. -->
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Master has its own range: 100% is the maximum and sits at the top with
                     the green line, so the thumb overhangs slightly above it at full scale
                     (like the channel thumbs do at their max). The green line and the "100"
                     label are pinned to the value=1.0 thumb centre in code-behind
                     (PositionMasterUnityLine). -->
                <Rectangle x:Name="MasterUnityLine" Grid.Column="1" Width="30" Height="2"
                           Fill="{StaticResource Brush.AccentPositive}"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                           IsHitTestVisible="False" />
                <Slider x:Name="MasterFader" Grid.Column="1" Style="{StaticResource Fader}" Minimum="0" Maximum="1"
                        Ticks="0.25,0.5,0.75" Value="{Binding Master.Volume, Mode=TwoWay}"
                        PreviewMouseLeftButtonDown="Fader_PreviewMouseLeftButtonDown" />
                <Canvas Grid.Column="2" Width="24" Height="170" Margin="2,10,0,4">
                    <TextBlock x:Name="MasterTopLabel" Style="{StaticResource ScaleLabel}" Text="100" Canvas.Top="6" />
                    <TextBlock Style="{StaticResource ScaleLabel}" Text="50" Canvas.Top="79" />
                </Canvas>
            </Grid>
            <TextBlock Text="{Binding Master.Percent}" HorizontalAlignment="Center"
                       FontSize="{StaticResource FontSize.BodyStrong}" FontWeight="Bold"
                       Foreground="{Binding Master.Volume, Converter={StaticResource GainToBrush}}" />
        </StackPanel>
    </Border>
</UserControl>
